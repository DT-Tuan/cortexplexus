# CortexPlexus Environment Variables
# Copy this file to .env and edit as needed.
# Most settings have sensible defaults — you can start with no changes.

# --- Embedding provider (default: Ollama offline, no API key needed) ---
# Uncomment and set your key ONLY if you want to use Google Gemini instead:
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# Get a free key at: https://aistudio.google.com/apikey

# --- Vertex AI embedding (optional, ADR-017/029) ---
# Faster than Ollama on a contended host (26.4 texts/s measured), but it is a
# paid Google Cloud service. Keep VERTEX_LOCATION regional: the "global"
# endpoint measures ~7.5x slower per call.
# EMBEDDING_PROVIDER=vertex
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL_ID=text-embedding-005
#
# Pick ONE credential:
#  (a) Express-mode key, minted in the Vertex AI Studio console. Simplest.
# VERTEX_API_KEY=your_vertex_express_key
#  (b) Service account. Required if you cannot mint an express key — the
#      project-scoped endpoint rejects API keys on the query string. Mount the
#      JSON key file read-only (see docker-compose.yml) and point this at the
#      CONTAINER path. Never bake the key into an image.
# VERTEX_CREDENTIAL_PATH=/etc/gcp/sa.json
#
# With neither set, Application Default Credentials are used — the right choice
# when running inside GCP with Workload Identity.

# --- Workspace mount (optional) ---
# If you want to index code that lives on this server, set the path here.
# It will be mounted read-only into the container at /workspace.
# Leave commented out if you only use the Local Agent (recommended).
# WORKSPACE_PATH=/path/to/your/code/workspace
